# ==============================================================================
# Obsidian Arena - Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the active '.env' file or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# Generate a production key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-cryptographically-secure-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,obsidians.codes

# ------------------------------------------------------------------------------
# PostgreSQL Database (e.g. Aiven Cloud / Self-hosted PostgreSQL)
# Sizing guidance for databases with a 20-connection limit (e.g. Aiven Cloud free/hobby tier):
# dj_db_conn_pool maintains an independent pool per worker process.
# Topology: 2 Gunicorn web processes + 1 Celery worker process = 3 processes.
# Per-process: POOL_SIZE=4, MAX_OVERFLOW=2 -> max 6 connections per process.
# Total max connections = 3 processes * 6 = 18 <= 20 connection limit.
# ------------------------------------------------------------------------------
DB_ENGINE=dj_db_conn_pool.backends.postgresql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_secure_db_password_here
DB_HOST=your-db-host.aivencloud.com
DB_PORT=23954
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_RECYCLE=300
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Email Gateway (Resend SMTP / SendGrid / AWS SES)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your_resend_api_key_here
DEFAULT_FROM_EMAIL=Obsidian Arena <noreply@obsidians.codes>

# ------------------------------------------------------------------------------
# OAuth Social Authentication (Google & GitHub)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# Redis Cache & Celery Task Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# Sandboxed Container Runtime ('podman' or 'docker')
# ------------------------------------------------------------------------------
CONTAINER_RUNNER=podman

# ------------------------------------------------------------------------------
# Production HTTPS & Cookie Security (Enable when deployed with SSL/TLS)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
